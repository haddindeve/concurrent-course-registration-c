    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What concurrency problem does this show?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lost updates on shared state - two threads reading the same seat count and both writing back, overfilling the course."
          }
        },
        {
          "@type": "Question",
          "name": "How is it prevented?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The read-modify-write on seat state happens inside a mutex-guarded critical section, so it is atomic with respect to other threads."
          }
        },
        {
          "@type": "Question",
          "name": "Why C and pthreads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They expose the synchronisation primitives directly, with no runtime hiding the mechanics."
